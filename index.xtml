<!DOCTYPE html> 
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>3D Голосовые и Текстовые Фигуры</title>
    <style>
        body { 
            margin: 0; 
            overflow: hidden; 
            background-color: #111; 
            font-family: Arial, sans-serif; 
        }
        #ui {
            position: absolute; 
            top: 15px; 
            left: 50%; 
            transform: translateX(-50%);
            text-align: center; 
            color: white; 
            z-index: 10; 
            width: 95%;
            max-width: 500px;
            background: rgba(0, 0, 0, 0.6);
            padding: 15px;
            border-radius: 15px;
        }
        input, button, select {
            padding: 10px 15px; 
            font-size: 16px; 
            margin: 4px;
            border: none; 
            border-radius: 8px;
            outline: none;
        }
        input { width: 140px; }
        button { background: #007bff; color: white; cursor: pointer; }
        button:hover { background: #0056b3; }
        .btn-mic { background: #28a745; }
        #status { margin-top: 10px; font-size: 14px; color: #ddd; }
    </style>
    <!-- Подгружаем Three.js -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
</head>
<body>

    <div id="ui">
        <div>
            <!-- Поле ввода текста -->
            <input type="text" id="text-input" placeholder="куб, шар...">
            <button id="send-btn">Создать</button>
            <button id="start-btn" class="btn-mic">🎙 Голос</button>
        </div>
        
        <div id="status">Введите текст или нажмите «Голос» (куб, шар, пирамида)</div>
    </div>

    <script>
        // 1. Создание 3D сцены
        const scene = new THREE.Scene();
        const camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
        const renderer = new THREE.WebGLRenderer({ antialias: true });
        renderer.setSize(window.innerWidth, window.innerHeight);
        document.body.appendChild(renderer.domElement);

        // Освещение
        const light = new THREE.DirectionalLight(0xffffff, 1.2);
        light.position.set(5, 5, 5).normalize();
        scene.add(light);
        scene.add(new THREE.AmbientLight(0x505050));

        camera.position.z = 5;

        let currentMesh = null;
        let isFlyingAway = false;

        // 2. Генерация 3D фигур
        function createShape(type) {
            if (currentMesh) scene.remove(currentMesh);
            isFlyingAway = false;

            let geometry;
            const cleanType = type.toLowerCase().trim();

            if (cleanType.includes('куб')) {
                geometry = new THREE.BoxGeometry(1.5, 1.5, 1.5);
            } else if (cleanType.includes('шар') || cleanType.includes('сфера')) {
                geometry = new THREE.SphereGeometry(1, 32, 32);
            } else if (cleanType.includes('пирамида') || cleanType.includes('конус')) {
                geometry = new THREE.ConeGeometry(1.2, 2, 4);
            } else {
                return false;
            }

            // Случайный яркий цвет
            const material = new THREE.MeshStandardMaterial({ 
                color: Math.random() * 0xffffff, 
                metalness: 0.2, 
                roughness: 0.3 
            });
            
            currentMesh = new THREE.Mesh(geometry, material);
            scene.add(currentMesh);

            // Запуск улёта через 2 секунды
            setTimeout(() => { isFlyingAway = true; }, 2000);
            return true;
        }

        // 3. Анимация (Вращение и Улёт за экран)
        function animate() {
            requestAnimationFrame(animate);

            if (currentMesh) {
                currentMesh.rotation.x += 0.02;
                currentMesh.rotation.y += 0.03;

                if (isFlyingAway) {
                    currentMesh.position.z -= 0.15;
                    currentMesh.position.x += 0.05;
                }
            }

            renderer.render(scene, camera);
        }
        animate();

        // 4. Обработка кнопок и ввода
        const status = document.getElementById('status');
        const textInput = document.getElementById('text-input');

        function processInput(val) {
            if (!val) return;
            if (createShape(val)) {
                status.innerText = `Показана фигура: "${val}"`;
            } else {
                status.innerText = `Не понял: "${val}". Попробуйте: куб, шар, пирамида`;
            }
        }

        // Клики по кнопке и Enter
        document.getElementById('send-btn').onclick = () => {
            processInput(textInput.value);
            textInput.value = '';
        };

        textInput.addEventListener('keypress', (e) => {
            if (e.key === 'Enter') {
                processInput(textInput.value);
                textInput.value = '';
            }
        });

        // 5. Голосовое управление (для смартфона и поддерживаемых браузеров)
        const btnMic = document.getElementById('start-btn');
        const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;

        if (SpeechRecognition) {
            const recognition = new SpeechRecognition();
            recognition.lang = 'ru-RU';

            btnMic.onclick = () => {
                try {
                    recognition.start();
                    status.innerText = "Слушаю голос...";
                } catch(e) {
                    status.innerText = "Запись уже идет...";
                }
            };

            recognition.onresult = (event) => {
                const word = event.results[0][0].transcript;
                processInput(word);
            };

            recognition.onerror = () => { 
                status.innerText = "Микрофон не сработал. Используйте поле ввода!"; 
            };
        } else {
            btnMic.style.display = 'none'; // Скрываем кнопку, если голосовой ввод недоступен
            status.innerText = "Ввод только текстом (браузер не поддерживает голос).";
        }

        // Ресайз экрана
        window.addEventListener('resize', () => {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
        });
    </script>
</body>
</html>
